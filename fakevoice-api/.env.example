# OpenAI-compatible API protection. Set a long random value.
FAKEVOICE_API_KEY=replace-with-a-long-random-secret
FAKEVOICE_MODEL_ID=kasane-teto-gpt-sovits

# Public base URL of a running GPT-SoVITS API server (the server that exposes POST /tts).
GPT_SOVITS_URL=https://your-gpt-sovits-server.example

# These paths/text are configured on the GPT-SoVITS server, not on this proxy.
GPT_SOVITS_REF_AUDIO_PATH=/absolute/path/to/teto-reference.wav
GPT_SOVITS_PROMPT_TEXT=Exact transcript of the reference audio
GPT_SOVITS_PROMPT_LANG=ja
GPT_SOVITS_TEXT_LANG=auto
GPT_SOVITS_TIMEOUT=180
FAKEVOICE_MAX_TEXT=1200
