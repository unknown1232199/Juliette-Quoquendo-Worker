# OpenAI-compatible API protection. Use a long random value.
FAKEVOICE_API_KEY=replace-with-a-long-random-secret
FAKEVOICE_MODEL_ID=kasane-teto-gpt-sovits

# Base URL of the separately hosted Yeyito777/teto-tts HTTP API (without /tts).
TETO_TTS_URL=https://your-teto-tts-host.example
TETO_TTS_LANGUAGE=auto
TETO_TTS_TIMEOUT=240

# Optional request limit.
FAKEVOICE_MAX_TEXT=1200
